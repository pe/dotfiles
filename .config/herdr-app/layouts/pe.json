{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "preview": "layouts/pe.svg",
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 268 },
      "min": 190,
      "max": 480,
      "resizable": false,
      "children": [
        {
          "id": "header",
          "type": "block",
          "size": { "px": 46 },
          "window_drag": true,
          "content": { "mod": "pe-header" }
        },
        {
          "id": "spaces",
          "type": "block",
          "content": { "mod": "pe-sidebar" }
        },
        {
          "id": "usage",
          "type": "block",
          "size": { "px": 36 },
          "content": { "mod": "pe-usage" }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "topbar",
          "type": "block",
          "size": { "px": 0 },
          "window_drag": true,
          "content": { "mod": "pe-topbar" }
        },
        {
          "id": "main",
          "type": "block",
          "padding": 8,
          "content": {
            "tab": "active",
            "pane": {
              "gap": 8,
              "radius": 10,
              "background": "background",
              "lone": true,
              "border": { "width": 1, "color": "border" },
              "focus": { "width": 1, "color": "accent" },
              "header": {
                "content": { "mod": "pane" },
                "height": 30,
                "position": "top",
                "reveal": "always"
              }
            }
          }
        }
      ]
    },
    {
      "id": "panel",
      "type": "column",
      "hidden": true,
      "size": { "px": 368 },
      "min": 280,
      "max": 900,
      "padding": 8,
      "children": [
        {
          "id": "panel-body",
          "type": "stack",
          "active": "changes",
          "children": [
            { "id": "changes", "type": "block", "content": { "mod": "changes" } }
          ]
        }
      ]
    }
  ]
}
